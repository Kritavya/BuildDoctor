{
  "name": "demo-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "demo-monorepo",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@demo/api",
      "version": "1.0.0",
      "dependencies": {
        "@demo/shared": "*"
      }
    },
    "apps/web": {
      "name": "@demo/web",
      "version": "1.0.0",
      "dependencies": {
        "@demo/shared": "*"
      }
    },
    "node_modules/@demo/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@demo/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@demo/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@demo/shared",
      "version": "1.0.0"
    }
  }
}
